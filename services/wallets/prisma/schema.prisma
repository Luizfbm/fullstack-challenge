generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletTransactionType {
  DEBIT
  CREDIT
}

enum WalletTransactionReason {
  BET_PLACED
  CASHOUT_PAYOUT
  INITIAL_GRANT
}

enum WalletInboxStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Wallet {
  id           String              @id @default(uuid())
  playerId     String              @unique
  balanceCents BigInt              @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@index([playerId])
  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  walletId    String
  type        WalletTransactionType
  reason      WalletTransactionReason
  amountCents BigInt
  referenceId String                  @unique
  createdAt   DateTime                @default(now())
  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WalletInboxMessage {
  id                   String                  @id @default(uuid())
  messageId            String                  @unique
  pattern              String
  playerId             String
  amountCents          BigInt
  referenceId          String                  @unique
  reason               WalletTransactionReason
  status               WalletInboxStatus
  responseOk           Boolean?
  responseApplied      Boolean?
  responseBalanceCents BigInt?
  errorCode            String?
  errorMessage         String?
  receivedAt           DateTime                @default(now())
  processedAt          DateTime?
  updatedAt            DateTime                @updatedAt

  @@index([status, receivedAt])
  @@index([playerId, receivedAt])
  @@map("wallet_inbox_messages")
}
