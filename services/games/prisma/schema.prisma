generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoundStatus {
  BETTING
  RUNNING
  CRASHED
  SETTLED
}

enum BetStatus {
  ACCEPTED
  REJECTED
  CASHOUT_PENDING_CREDIT
  CASHED_OUT
  LOST
}

enum WalletOutboxStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  RETRYABLE
}

enum WalletOutboxType {
  WALLET_DEBIT
  WALLET_CREDIT
}

model Round {
  id                 String      @id @default(uuid())
  status             RoundStatus
  bettingStartsAt    DateTime
  bettingEndsAt      DateTime
  startedAt          DateTime?
  crashedAt          DateTime?
  crashPointBp       Int
  serverSeedHash     String
  serverSeed         String?
  clientSeed         String
  nonce              Int
  chainIndex         Int
  nextServerSeedHash String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  bets               Bet[]

  @@unique([chainIndex])
  @@index([status, createdAt])
  @@map("rounds")
}

model Bet {
  id                      String    @id @default(uuid())
  roundId                 String
  playerId                String
  username                String
  amountCents             BigInt
  status                  BetStatus
  autoCashoutMultiplierBp Int?
  cashoutMultiplierBp     Int?
  payoutCents             BigInt?
  rejectionReason         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  round                   Round     @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@unique([roundId, playerId])
  @@index([playerId, createdAt])
  @@index([roundId, status])
  @@map("bets")
}

model WalletOutboxMessage {
  id                   String             @id @default(uuid())
  type                 WalletOutboxType
  status               WalletOutboxStatus
  roundId              String
  betId                String?
  playerId             String
  username             String?
  amountCents          BigInt
  referenceId          String             @unique
  reason               String
  attempts             Int                @default(0)
  availableAt          DateTime           @default(now())
  lockedAt             DateTime?
  responseApplied      Boolean?
  responseBalanceCents BigInt?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, availableAt])
  @@index([roundId])
  @@index([playerId, createdAt])
  @@map("wallet_outbox_messages")
}

model AutoBetSession {
  id                      String                  @id
  playerId                String
  username                String
  status                  String
  strategy                String                  @default("FIXED")
  amountCents             BigInt
  nextAmountCents         BigInt                  @default(0)
  autoCashoutMultiplierBp Int?
  maxRounds               Int
  roundsPlayed            Int                     @default(0)
  martingaleMultiplier    Int                     @default(2)
  martingaleMaxSteps      Int                     @default(0)
  martingaleCurrentStep   Int                     @default(0)
  netProfitCents          BigInt                  @default(0)
  stopLossCents           BigInt?
  takeProfitCents         BigInt?
  stopReason              String?
  startsAfterRoundId      String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  stoppedAt               DateTime?
  executions              AutoBetRoundExecution[]

  @@index([playerId, createdAt])
  @@index([status])
  @@map("auto_bet_sessions")
}

model AutoBetRoundExecution {
  id               String         @id
  sessionId        String
  roundId          String
  betId            String?
  status           String
  reason           String?
  resultStatus     String?
  resultDeltaCents BigInt?
  resultAppliedAt  DateTime?
  createdAt        DateTime       @default(now())
  session          AutoBetSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, roundId])
  @@index([roundId])
  @@map("auto_bet_round_executions")
}
